        },
        {
          "key": "bajaj",
          "bank": "Bajaj Finance",
          "category": "NBFC / ARC",
          "pdf_pattern": "\\.pdf",
          "index_urls": [
            "https://www.bajajfinserv.in/sarfaesi-auction-notices"
          ]
        },
        {
          "key": "drt",
          "bank": "DRT Recovery Officer",
          "category": "DRT",
          "cards": true,
          "pdf_pattern": "\\.pdf",
          "index_urls": [
            "https://drt.auctiontiger.net/"
          ]
        },
        {
          "key": "mstc",
          "bank": "MSTC (Govt)",
          "category": "Government",
          "cards": true,
          "pdf_pattern": "\\.pdf",
          "index_urls": [
            "https://www.mstcecommerce.com/auctionhome/index.jsp"
